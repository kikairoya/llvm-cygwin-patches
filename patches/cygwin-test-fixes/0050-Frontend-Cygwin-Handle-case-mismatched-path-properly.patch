From 75cb7a3ba40bb7c8e545cf4933b061d45c20fe19 Mon Sep 17 00:00:00 2001
From: kikairoya <kikairoya@gmail.com>
Date: Fri, 2 May 2025 23:16:55 +0900
Subject: [PATCH 50/63] [Frontend][Cygwin] Handle case-mismatched path properly
 on cygwin

`realpath` provided by cygwin1.dll does not return real-name: that
resolves symlink and cygwin-mountpoint but not case-mismatch.
So to detect case-mismatched `#include`, need to dedicated workaround
using Win32API.
---
 clang/lib/Frontend/DependencyFile.cpp |  2 +-
 llvm/lib/Support/Unix/Path.inc        | 41 +++++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/clang/lib/Frontend/DependencyFile.cpp b/clang/lib/Frontend/DependencyFile.cpp
index 5702d1dabcc8b599d3cf7f683d4585b32b62a9b1..eede8e01c91cabd2bcd6b1e8eb07d763a0a5403e 100644
--- a/clang/lib/Frontend/DependencyFile.cpp
+++ b/clang/lib/Frontend/DependencyFile.cpp
@@ -200,7 +200,7 @@ void DependencyCollector::maybeAddDependency(StringRef Filename,
 
 bool DependencyCollector::addDependency(StringRef Filename) {
   StringRef SearchPath;
-#ifdef _WIN32
+#if defined(_WIN32) || defined(__CYGWIN__)
   // Make the search insensitive to case and separators.
   llvm::SmallString<256> TmpPath = Filename;
   llvm::sys::path::native(TmpPath);
diff --git a/llvm/lib/Support/Unix/Path.inc b/llvm/lib/Support/Unix/Path.inc
index b9e40d161b8332ae198238aeef33e7dd9663d31b..cb077552a59615c1f86596ab13d24d74baf16859 100644
--- a/llvm/lib/Support/Unix/Path.inc
+++ b/llvm/lib/Support/Unix/Path.inc
@@ -55,6 +55,12 @@ extern char **environ;
 #include <sys/ps.h>
 #endif
 
+#if defined(__CYGWIN__)
+#include <io.h>
+#include <sys/cygwin.h>
+#include <windows.h>
+#endif
+
 // Both stdio.h and cstdio are included via different paths and
 // stdcxx's cstdio doesn't include stdio.h, so it doesn't #undef the macros
 // either.
@@ -1239,6 +1245,41 @@ std::error_code openFileForRead(const Twine &Name, int &ResultFD,
 
 std::error_code getRealPathFromHandle(file_t Handle,
                                       SmallVectorImpl<char> &RealPath) {
+#if defined(__CYGWIN__)
+  // Cygwin's ::realpath or similar functionality don't canonicalize casing, so
+  // try WinAPI first.
+  SmallVector<wchar_t, PATH_MAX> BufferW;
+  BufferW.resize_for_overwrite(BufferW.capacity());
+  const auto H = reinterpret_cast<HANDLE>(::_get_osfhandle(Handle.get()));
+  ssize_t CountChars =
+      ::GetFinalPathNameByHandleW(H, BufferW.begin(), BufferW.capacity(),
+                                  FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+  if (CountChars > 0 && (size_t)CountChars >= BufferW.capacity()) {
+    // The buffer wasn't big enough, try again.  In this case the return value
+    // *does* indicate the size of the null terminator.
+    BufferW.resize_for_overwrite(CountChars);
+    CountChars =
+        ::GetFinalPathNameByHandleW(H, BufferW.begin(), BufferW.size(),
+                                    FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+  }
+  BufferW.truncate(CountChars);
+  if (CountChars > 0) {
+    BufferW.truncate(CountChars);
+    CountChars =
+        ::cygwin_conv_path(CCP_WIN_W_TO_POSIX, BufferW.begin(), nullptr, 0);
+    if (CountChars > 0) {
+      RealPath.resize_for_overwrite(CountChars);
+      if (::cygwin_conv_path(CCP_WIN_W_TO_POSIX, BufferW.begin(),
+                             RealPath.begin(), RealPath.size()) > 0) {
+        RealPath.truncate(RealPath.size() - 1);
+        return std::error_code();
+      }
+      // On any errors, fallback to the generic implementation.
+      RealPath.clear();
+    }
+  }
+  // fallthrough
+#endif
 #if defined(F_GETPATH)
   char Buffer[PATH_MAX];
   // When F_GETPATH is available, it is the quickest way to get
