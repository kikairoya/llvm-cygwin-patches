From c579fa64fb4cc020d38e13c26065abc0168930ae Mon Sep 17 00:00:00 2001
From: kikairoya <kikairoya@gmail.com>
Date: Sun, 21 Sep 2025 09:57:11 +0900
Subject: [PATCH 22/38] workaround for 2GiB limit

---
 clang/unittests/CMakeLists.txt             | 4 ++++
 clang/unittests/Interpreter/CMakeLists.txt | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/clang/unittests/CMakeLists.txt b/clang/unittests/CMakeLists.txt
index b2fee01649abc6d7e2eefd32524cc07fbc02790d..2663307143fe6df267ad11f329b48447c1759d5d 100644
--- a/clang/unittests/CMakeLists.txt
+++ b/clang/unittests/CMakeLists.txt
@@ -129,6 +129,10 @@ add_distinct_clang_unittest(AllClangUnitTests
   ${LLVM_COMPONENTS}
 )
 
+if ((MINGW OR CYGWIN) AND NOT (CLANG_LINK_CLANG_DYLIB OR BUILD_SHARED_LIBS))
+  target_link_options(AllClangUnitTests PRIVATE "-Wl,-S")
+endif()
+
 # The Tooling library has some internal headers. Make those work. If we like
 # the merged clang unit test binary, we can update the include paths and make
 # this the default.
diff --git a/clang/unittests/Interpreter/CMakeLists.txt b/clang/unittests/Interpreter/CMakeLists.txt
index ad5836d8a1b7fc0647642e5146716974061ebb40..5d07ce66eae9a290caf9ff9d34c3ad03f128f339 100644
--- a/clang/unittests/Interpreter/CMakeLists.txt
+++ b/clang/unittests/Interpreter/CMakeLists.txt
@@ -99,6 +99,10 @@ set_target_properties(ClangReplInterpreterTests PROPERTIES
 )
 endif()
 
+if ((MINGW OR CYGWIN) AND NOT (CLANG_LINK_CLANG_DYLIB OR BUILD_SHARED_LIBS))
+  target_link_options(ClangReplInterpreterTests PRIVATE "-Wl,-S")
+endif()
+
 # Interpreter exception tests are not supported on Windows or Emscripten.
 if(NOT WIN32 AND NOT EMSCRIPTEN)
   add_subdirectory(ExceptionTests)
-- 
2.55.0

