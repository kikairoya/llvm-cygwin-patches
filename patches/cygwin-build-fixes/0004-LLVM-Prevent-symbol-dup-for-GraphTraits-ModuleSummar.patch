From 94ac9e35ec03b65e450972a570d9501dfb2096ed Mon Sep 17 00:00:00 2001
From: kikairoya <kikairoya@gmail.com>
Date: Fri, 5 Dec 2025 20:06:12 +0900
Subject: [PATCH 04/38] [LLVM] Prevent symbol dup for
 GraphTraits<ModuleSummaryIndex *>::getEntryNode

---
 llvm/include/llvm/IR/ModuleSummaryIndex.h | 10 +---------
 llvm/lib/IR/ModuleSummaryIndex.cpp        | 11 +++++++++++
 2 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/llvm/include/llvm/IR/ModuleSummaryIndex.h b/llvm/include/llvm/IR/ModuleSummaryIndex.h
index 31e6898130e7d4b8aedb59dcf8ad654fb9b93d8a..fe1ff1d887e3e5ca531995f1ea3e12b93288cebb 100644
--- a/llvm/include/llvm/IR/ModuleSummaryIndex.h
+++ b/llvm/include/llvm/IR/ModuleSummaryIndex.h
@@ -2191,15 +2191,7 @@ template <> struct GraphTraits<ValueInfo> {
 
 template <>
 struct GraphTraits<ModuleSummaryIndex *> : public GraphTraits<ValueInfo> {
-  static NodeRef getEntryNode(ModuleSummaryIndex *I) {
-    std::unique_ptr<GlobalValueSummary> Root =
-        std::make_unique<FunctionSummary>(I->calculateCallGraphRoot());
-    GlobalValueSummaryInfo G(I->haveGVs());
-    G.addSummary(std::move(Root));
-    static auto P =
-        GlobalValueSummaryMapTy::value_type(GlobalValue::GUID(0), std::move(G));
-    return ValueInfo(I->haveGVs(), &P);
-  }
+  LLVM_ABI static NodeRef getEntryNode(ModuleSummaryIndex *I);
 };
 } // end namespace llvm
 
diff --git a/llvm/lib/IR/ModuleSummaryIndex.cpp b/llvm/lib/IR/ModuleSummaryIndex.cpp
index 7b87386418660af283c393aa6d8edf2a8c81c8ce..28cba1e167527cb0ec22896a70c3028857e376c2 100644
--- a/llvm/lib/IR/ModuleSummaryIndex.cpp
+++ b/llvm/lib/IR/ModuleSummaryIndex.cpp
@@ -754,3 +754,14 @@ void ModuleSummaryIndex::exportToDot(
 
   OS << "}";
 }
+
+GraphTraits<ValueInfo>::NodeRef
+GraphTraits<ModuleSummaryIndex *>::getEntryNode(ModuleSummaryIndex *I) {
+  std::unique_ptr<GlobalValueSummary> Root =
+      std::make_unique<FunctionSummary>(I->calculateCallGraphRoot());
+  GlobalValueSummaryInfo G(I->haveGVs());
+  G.addSummary(std::move(Root));
+  static auto P =
+      GlobalValueSummaryMapTy::value_type(GlobalValue::GUID(0), std::move(G));
+  return ValueInfo(I->haveGVs(), &P);
+}
-- 
