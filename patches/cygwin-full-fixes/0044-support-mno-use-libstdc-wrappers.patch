From 4efb4dd70ee4502c787e5eb8808efbda25b161b0 Mon Sep 17 00:00:00 2001
From: kikairoya <kikairoya@gmail.com>
Date: Sun, 6 Sep 2026 13:15:09 +0900
Subject: [PATCH 44/51] support -mno-use-libstdc-wrappers

---
 clang/include/clang/Options/Options.td |  2 ++
 clang/lib/Driver/ToolChains/Cygwin.cpp | 41 +++++++++++++++-----------
 clang/test/Driver/cygwin.cpp           |  4 +++
 3 files changed, 29 insertions(+), 18 deletions(-)

diff --git a/clang/include/clang/Options/Options.td b/clang/include/clang/Options/Options.td
index 0e57c128210b311f85761a83831a731673a50d9e..61770109c95f17c8f4e2fc30d20c03df53e25ade 100644
--- a/clang/include/clang/Options/Options.td
+++ b/clang/include/clang/Options/Options.td
@@ -5623,6 +5623,8 @@ def mconsole : Joined<["-"], "mconsole">, Group<m_Group>;
 def mwindows : Joined<["-"], "mwindows">, Group<m_Group>;
 def mdll : Joined<["-"], "mdll">, Group<m_Group>;
 def municode : Joined<["-"], "municode">, Group<m_Group>;
+def muse_libstdc_wrappers : Joined<["-"], "muse-libstdc-wrappers">, Group<m_Group>;
+def mno_use_libstdc_wrappers : Joined<["-"], "mno-use-libstdc-wrappers">, Group<m_Group>;
 def mthreads : Joined<["-"], "mthreads">, Group<m_Group>;
 def marm64x : Joined<["-"], "marm64x">, Group<m_Group>,
   Visibility<[ClangOption, CLOption]>,
diff --git a/clang/lib/Driver/ToolChains/Cygwin.cpp b/clang/lib/Driver/ToolChains/Cygwin.cpp
index d78c9983e5f27afac85db84b2888c0818aac818a..ff108407c1e8f27dd93bf5d69cc0ca4ff9e980c1 100644
--- a/clang/lib/Driver/ToolChains/Cygwin.cpp
+++ b/clang/lib/Driver/ToolChains/Cygwin.cpp
@@ -183,24 +183,29 @@ void cygwin::Linker::ConstructJob(Compilation &C, const JobAction &JA,
     CmdArgs.push_back("console");
   }
 
-  if (ToolChain.getTriple().isArch32Bit()) {
-    CmdArgs.push_back("--wrap=_Znwj");
-    CmdArgs.push_back("--wrap=_Znaj");
-    CmdArgs.push_back("--wrap=_ZdlPv");
-    CmdArgs.push_back("--wrap=_ZdaPv");
-    CmdArgs.push_back("--wrap=_ZnwjRKSt9nothrow_t");
-    CmdArgs.push_back("--wrap=_ZnajRKSt9nothrow_t");
-    CmdArgs.push_back("--wrap=_ZdlPvRKSt9nothrow_t");
-    CmdArgs.push_back("--wrap=_ZdaPvRKSt9nothrow_t");
-  } else {
-    CmdArgs.push_back("--wrap=_Znwm");
-    CmdArgs.push_back("--wrap=_Znam");
-    CmdArgs.push_back("--wrap=_ZdlPv");
-    CmdArgs.push_back("--wrap=_ZdaPv");
-    CmdArgs.push_back("--wrap=_ZnwmRKSt9nothrow_t");
-    CmdArgs.push_back("--wrap=_ZnamRKSt9nothrow_t");
-    CmdArgs.push_back("--wrap=_ZdlPvRKSt9nothrow_t");
-    CmdArgs.push_back("--wrap=_ZdaPvRKSt9nothrow_t");
+  Arg *WrapArg = Args.getLastArg(options::OPT_mno_use_libstdc_wrappers,
+                                 options::OPT_muse_libstdc_wrappers);
+
+  if (!WrapArg || WrapArg->getOption().matches(options::OPT_muse_libstdc_wrappers)) {
+    if (ToolChain.getTriple().isArch32Bit()) {
+      CmdArgs.push_back("--wrap=_Znwj");
+      CmdArgs.push_back("--wrap=_Znaj");
+      CmdArgs.push_back("--wrap=_ZdlPv");
+      CmdArgs.push_back("--wrap=_ZdaPv");
+      CmdArgs.push_back("--wrap=_ZnwjRKSt9nothrow_t");
+      CmdArgs.push_back("--wrap=_ZnajRKSt9nothrow_t");
+      CmdArgs.push_back("--wrap=_ZdlPvRKSt9nothrow_t");
+      CmdArgs.push_back("--wrap=_ZdaPvRKSt9nothrow_t");
+    } else {
+      CmdArgs.push_back("--wrap=_Znwm");
+      CmdArgs.push_back("--wrap=_Znam");
+      CmdArgs.push_back("--wrap=_ZdlPv");
+      CmdArgs.push_back("--wrap=_ZdaPv");
+      CmdArgs.push_back("--wrap=_ZnwmRKSt9nothrow_t");
+      CmdArgs.push_back("--wrap=_ZnamRKSt9nothrow_t");
+      CmdArgs.push_back("--wrap=_ZdlPvRKSt9nothrow_t");
+      CmdArgs.push_back("--wrap=_ZdaPvRKSt9nothrow_t");
+    }
   }
 
   if (Args.hasArg(options::OPT_mdll))
diff --git a/clang/test/Driver/cygwin.cpp b/clang/test/Driver/cygwin.cpp
index 66fa9fbcfc1e0ad5557326587b44307b527062f8..7c00ac0e1219b2d4c7b973b2bcb0e79c120b8728 100644
--- a/clang/test/Driver/cygwin.cpp
+++ b/clang/test/Driver/cygwin.cpp
@@ -167,6 +167,10 @@
 // CHECK-64-WRAP-SAME: "--wrap=_ZdlPvRKSt9nothrow_t"
 // CHECK-64-WRAP-SAME: "--wrap=_ZdaPvRKSt9nothrow_t"
 
+// RUN: %clang -### %s --target=x86_64-pc-cygwin --sysroot=%S/Inputs/basic_cygwin_tree \
+// RUN:  -mno-use-libstdc-wrappers 2>&1 | FileCheck --check-prefix=CHECK-NOWRAP %s
+// CHECK-NOWRAP-NOT: --wrap
+
 // RUN: %clang -### %s --target=x86_64-pc-cygwin --sysroot=%S/Inputs/basic_cygwin_tree \
 // RUN:                -resource-dir=%S/Inputs/resource_dir -rtlib=compiler-rt \
 // RUN:   2>&1 | FileCheck --check-prefix=CHECK-64-RTLIB %s
-- 
2.55.0

